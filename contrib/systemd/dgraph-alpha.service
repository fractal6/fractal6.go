[Unit]
Description=Dgraph Alpha instance
Wants=network.target
After=network.target dgraph-zero.service
Requires=dgraph-zero.service

[Service]
Type=simple
WorkingDirectory=/home/admin/db
ExecStart=/home/admin/fractal6/dgraph alpha --config /home/admin/fractal6/contrib/dgraph/config-alpha.yml'
LimitNOFILE=65536
Restart=on-failure
StandardOutput=journal
StandardError=journal
User=dgraph
Group=dgraph

[Install]
WantedBy=multi-user.target
