# Label on test-org, linked to tension
_:label <dgraph.type> "Label" .
_:label <Label.rootnameid> "test-org" .
_:label <Label.name> "bug" .
_:label <Label.color> "#d73a4a" .
_:tension <Tension.labels> _:label .
_:label <Label.tensions> _:tension .
_:org <Node.labels> _:label .
_:label <Label.nodes> _:org .

# Comment on tension
_:comment <dgraph.type> "Comment" .
_:comment <Post.createdBy> _:user1 .
_:comment <Post.createdAt> "2026-01-01T00:01:00Z" .
_:comment <Post.message> "This is the first comment on the test tension" .
_:tension <Tension.comments> _:comment .

# Comments used by /file/* integration tests. Messages are unique markers so
# the suite can resolve uids at runtime (uids are not stable across DropAll).

# Public-org comment authored by testuser (file upload happy path).
_:file_pub_c1 <dgraph.type> "Comment" .
_:file_pub_c1 <Post.createdBy> _:user1 .
_:file_pub_c1 <Post.createdAt> "2026-01-01T00:02:00Z" .
_:file_pub_c1 <Post.message> "file-test: public comment by testuser" .
_:tension <Tension.comments> _:file_pub_c1 .

# Public-org comment authored by testuser2 (used to assert non-author cannot
# attach files to a comment they did not author).
_:file_pub_c2 <dgraph.type> "Comment" .
_:file_pub_c2 <Post.createdBy> _:user2 .
_:file_pub_c2 <Post.createdAt> "2026-01-01T00:03:00Z" .
_:file_pub_c2 <Post.message> "file-test: public comment by testuser2" .
_:tension <Tension.comments> _:file_pub_c2 .

